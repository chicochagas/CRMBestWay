NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Somente servidor — nunca em NEXT_PUBLIC_*
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Base do link de convite (local: http://localhost:3000)
SITE_URL=
